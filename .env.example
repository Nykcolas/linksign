# Frontend — vão para o bundle, então só chaves públicas aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Project Settings → API Keys. Projetos novos mostram a publishable key;
# projetos antigos mostram a anon key. Use a que o seu painel tiver.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------------
# NÃO coloque os segredos abaixo neste arquivo — nada aqui chega às Edge
# Functions, que é onde eles são lidos. O lugar deles é:
#
#   supabase secrets set AUTENTIQUE_TOKEN=...
#   supabase secrets set AUTENTIQUE_WEBHOOK_SECRET=...   # secrets dos endpoints no painel, separados por vírgula
#   supabase secrets set AUTENTIQUE_SANDBOX=true         # false em produção
#   supabase secrets set APP_ORIGIN=https://linksign.pages.dev
